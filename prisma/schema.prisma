generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GESTAO
  VENDEDOR
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                Role     @default(VENDEDOR)
  // Lista de chaves de aba liberadas pra esse usuário (ver src/lib/tabs.ts).
  // Vazio = usa o padrão do role (comportamento de antes, continua funcionando sozinho).
  allowedTabs         String[] @default([])
  // Ids de Store que esse usuário pode ver (ver getStoreRestriction em lib/permissions.ts).
  // Vazio = sem restrição, vê todas as lojas.
  allowedStores       String[] @default([])
  // Mesmo padrão de allowedStores, mas pra Marca e Tabela de Preço (ver getMarcaRestriction/
  // getTabelaPrecoRestriction em lib/permissions.ts). Vazio = sem restrição.
  allowedMarcas       String[] @default([])
  allowedTabelasPreco String[] @default([])
  // Controla se o usuário vê colunas/KPIs financeiros (receita, custo, margem).
  // true por padrão — só desmarcar no Admin pra quem não deve ver.
  canSeeFinancials    Boolean  @default(true)
  createdAt           DateTime @default(now())

  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Uma loja/unidade (o "Armazenador" no DAPIC). Matriz não vende (sellsProducts=false).
// dapicArmazenadorId liga direto com o Id retornado por GET /armazenadores na API real —
// nem todo armazenador é uma loja de verdade (ex: "Defeito", "Lixeira", "Bonificação").
model Store {
  id                 String  @id @default(cuid())
  code               String  @unique
  name               String
  sellsProducts      Boolean @default(true)
  dapicArmazenadorId Int?    @unique
  // Quando preenchido, agrupa essa loja com outras de mesmo displayGroup em uma única opção
  // no filtro (ex: CD e ATACADO viram um checkbox só "TVB Site e Atacado"), sem perder os
  // dados separados por baixo — evita somar/sobrescrever quantidade errado.
  displayGroup       String?

  sales               Sale[]
  stockSnapshots      StockSnapshot[]
  returns             Return[]
  gifts               Gift[]
  syncLogs            SyncLog[]
  stockMinimumRules   StockMinimumRule[]
  contentPerformances ContentPerformance[]
  vendedores          Vendedor[]
  clienteAtribuicoes  ClienteVendedorAtribuicao[]
}

// Vendedor como entidade de verdade (2026-09-21) — até aqui "vendedor" só existia como texto
// livre em Sale.vendedor, sem lugar pra guardar "essa pessoa saiu da empresa". Populado por
// backfill (1 linha por nome distinto de Sale.vendedor em cada loja, ativo=true por padrão) e
// dali em diante gerenciado no Painel Admin (só ADMIN liga/desliga). Desativar um vendedor NÃO
// apaga nada — só dispara a redistribuição da carteira dele (ver ClienteVendedorAtribuicao).
model Vendedor {
  id        String   @id @default(cuid())
  storeId   String
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store             Store                       @relation(fields: [storeId], references: [id])
  clientesAtuais    ClienteVendedorAtribuicao[] @relation("VendedorAtual")
  clientesOriginais ClienteVendedorAtribuicao[] @relation("VendedorOriginal")

  @@unique([storeId, nome])
}

// "Dona" persistente de um cliente dentro de uma loja — pedido do Rodrigo em 2026-09-21: sem
// isso, a lista de clientes de um vendedor teria que ser recalculada toda vez a partir do
// histórico de vendas (Sale.vendedor), e o mesmo cliente podia pular de vendedor a cada sync.
// clienteNorm = nome do cliente já normalizado (trim+upper), mesmo padrão usado em
// getClienteSegmentacao/getClienteFicha pra casar variação de capitalização entre vendas.
// vendedorOriginalId só é preenchido quando o cliente foi redistribuído (o vendedor que ele
// tinha antes ficou inativo) — cada nova redistribuição sobrescreve pra quem estava saindo
// naquele momento (é sempre "de quem esse cliente era antes desta troca", não o 1º da história).
model ClienteVendedorAtribuicao {
  id                 String   @id @default(cuid())
  storeId            String
  clienteNorm        String
  vendedorAtualId    String
  vendedorOriginalId String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  store            Store     @relation(fields: [storeId], references: [id])
  vendedorAtual    Vendedor  @relation("VendedorAtual", fields: [vendedorAtualId], references: [id])
  vendedorOriginal Vendedor? @relation("VendedorOriginal", fields: [vendedorOriginalId], references: [id])

  @@unique([storeId, clienteNorm])
  @@index([vendedorAtualId])
}

// Estoque mínimo definido manualmente pelo Rodrigo (o valor que vem do DAPIC nem sempre é
// bom) — colecao nulo = vale pra qualquer coleção desse grupo+tamanho+loja. Regra mais
// específica (com colecao) ganha da mais genérica na hora de aplicar.
model StockMinimumRule {
  id          String   @id @default(cuid())
  storeId     String
  grupo       String
  tamanho     String
  colecao     String?
  valorMinimo Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, grupo, tamanho, colecao])
}

// Mapa de Compras — % de crescimento de receita esperado que o Rodrigo escolhe (ele mesmo, não
// calculado), aplicado sobre a receita do mesmo mês do ano anterior pra projetar cada mês futuro
// — mesma lógica da linha "Crescimento do Ticket" da planilha dele. Uma linha só (id fixo
// "global"), configuração da empresa toda, não por grupo — pedido do Rodrigo em 2026-09-03.
model MapaComprasConfig {
  id             String @id
  crescimentoPct Float
  // Verba total planejada pra visão consolidada de compras (seção 7 do pedido do Rodrigo de
  // 2026-10-27: BEST SELLER vs DROP) — nullable porque é opcional configurar; sem valor, a
  // priorização de orçamento (priorizarOrcamentoCompras) não tem limite pra aplicar, só ordena.
  orcamentoTotalPlanejado Float?
}

// Parâmetros de compra Best Seller por grupo (seção 4 do pedido do Rodrigo de 2026-10-27) —
// reaproveita o modelo já existente de meta por grupo (CoberturaMeta já guarda mesesCobertura)
// em vez de criar uma tabela nova: estoque de segurança e prazo de entrega do fornecedor também
// são decisão por grupo, não por produto nem por loja. Ambos nullable — sem valor cadastrado, o
// motor de cálculo assume 0 e sinaliza a premissa como não confirmada (não inventa um número).
model CoberturaMeta {
  id             String   @id @default(cuid())
  grupo          String   @unique
  mesesCobertura Float
  estoqueSegurancaUnidades Int?
  leadTimeDias             Int?
  updatedAt      DateTime @updatedAt
}

// Matriz de desconto por Coleção × faixa de sell-through da Análises de Promoção — o "quadrinho"
// editável (ver promotion-rules.ts). Uma linha só (id fixo "global"), mesma convenção de
// MapaComprasConfig. Sem linha ainda = usa os defaults hardcoded em promotionRules (nunca editado
// ainda). Pedido do Rodrigo em 2026-09-28: a matriz editada na tela precisa sobreviver a um
// F5/nova sessão, não só durar enquanto a aba tá aberta.
model PromotionRulesConfig {
  id                 String   @id
  matriz             Json
  descontoBestseller Float
  descontoPadrao     Float
  updatedAt          DateTime @updatedAt
}

enum TipoCompraProduto {
  BEST_SELLER
  DROP
}

enum StatusComercialProduto {
  ATIVO
  EM_LANCAMENTO
  EM_REPOSICAO
  EM_ENCERRAMENTO
  DESCONTINUADO
}

enum PossibilidadeReposicao {
  SIM
  NAO
  A_CONFIRMAR
}

// Classificação de compra por produto — pedido do Rodrigo em 2026-10-27: separar reposição
// recorrente (BEST SELLER) de coleção limitada (DROP) pro Mapa de Compras recomendar quantidade
// de forma diferente em cada caso. Chave é "cod" (= IdGradeProduto do DAPIC, mesmo identificador
// de Sale/StockSnapshot/ProductionOrder) — não existe tabela mestre de Produto hoje (decisão
// documentada acima, em Sale), então essa é a primeira tabela "cadastral" de produto do Radar, e
// só carrega os campos que ESSA funcionalidade precisa, não um cadastro geral. Produto sem linha
// aqui = classificação desconhecida (cai na fila de revisão, ver getFilaRevisaoClassificacao) —
// nunca herda BEST_SELLER só por vender muito, nem DROP só por ser coleção nova (pedido explícito
// do Rodrigo, seção 2 do pedido original).
model ClassificacaoProduto {
  id                       String                 @id @default(cuid())
  cod                      String                 @unique
  produto                  String
  grupo                    String
  colecao                  String?
  tipoCompra               TipoCompraProduto
  statusComercial          StatusComercialProduto
  possibilidadeReposicao   PossibilidadeReposicao
  dataLancamento           DateTime?
  dataEncerramentoPrevista DateTime?
  // Verba destinada a ESSE drop especificamente (seção 5 do pedido) — só faz sentido pra
  // tipoCompra = DROP, nullable pros dois casos (Best Seller não usa, Drop pode não ter ainda).
  orcamentoDrop            Float?
  observacoes              String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  historico ClassificacaoProdutoHistorico[]

  @@index([grupo])
  @@index([tipoCompra])
  @@index([colecao])
}

// Histórico de alteração de classificação (seção 2 do pedido: "histórico de alterações quando
// viável"). Guarda só o campo/de/para que mudou, não um snapshot completo da linha — suficiente
// pra auditar reclassificação Drop↔Best Seller e mudança de possibilidadeReposicao sem duplicar
// a tabela inteira a cada edição.
model ClassificacaoProdutoHistorico {
  id              String   @id @default(cuid())
  classificacaoId String
  campo           String
  valorAnterior   String?
  valorNovo       String?
  alteradoEm      DateTime @default(now())
  alteradoPor     String?

  classificacao ClassificacaoProduto @relation(fields: [classificacaoId], references: [id])

  @@index([classificacaoId])
}

// Decisão humana sobre uma recomendação de compra (seção 9 do pedido: simulação não grava nada —
// calcularSugestaoBestSeller/calcularSugestaoDrop em src/lib/metrics/compras-inteligencia.ts são
// funções puras, sem efeito em banco — só grava quando o Rodrigo CONFIRMA uma decisão).
// "premissas" guarda as premissas/avisos que o motor de cálculo retornou NO MOMENTO da decisão
// (Json, não normalizado), pra auditar depois por que a sugestão daquele dia foi aquele número,
// mesmo que os dados de venda/estoque mudem depois.
model DecisaoCompra {
  id                  String            @id @default(cuid())
  cod                 String?
  grupo               String
  tipoCompra          TipoCompraProduto
  quantidadeSugerida  Int
  quantidadeAprovada  Int
  justificativaAjuste String?
  premissas           Json
  decididoEm          DateTime          @default(now())
  decididoPor         String?

  @@index([grupo])
  @@index([cod])
}

// Token pra conectar o Radar num Custom GPT (ChatGPT) ou Conector MCP (Claude) — pedido do
// Rodrigo em 2026-09-08. Uma linha só (id fixo "radar-api"), gerada/trocada e RE-VISUALIZADA
// pelo Painel Admin (pedido dele: não quer ser forçado a reconectar ChatGPT/Claude só porque
// esqueceu de copiar). Por isso fica em texto puro, não hash como User.passwordHash — decisão
// consciente, é uma API key de uso pessoal, não uma senha. Dá acesso total aos dados (sem a
// separação por loja/financeiro do login normal).
model ApiToken {
  id        String   @id
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Confiança do vínculo Sale/Gift -> ClienteCadastro (ver clienteCadastroId). Dois valores de
// propósito, nomeados pelo MECANISMO real usado em cada caso, não por "CPF" — investigação de
// 2026-11-06 confirmou que a API do DAPIC nunca expõe CPF/CNPJ diretamente em /vendaspdv nem em
// /faturas (lista ou detalhe), só em /clientes (DapicCliente.CpfCnpj, já capturado em
// ClienteCadastro.cpfCnpj). O que /faturas EXPÕE (e não era capturado até aqui) é "IdCliente" —
// o Id do cliente no MESMO espaço de /clientes, ou seja, já é o identificador que bate 1:1 com
// ClienteCadastro.dapicId. É mais forte que casar por CPF (nenhuma ambiguidade de formatação,
// nenhuma comparação de string) — por isso ID, não CPF, é o nível "confiável" aqui.
//   ID   = resolvido por um identificador direto do DAPIC (fatura.IdCliente -> ClienteCadastro.dapicId)
//          — sem comparação de texto, mesmo nível de confiança que uma foreign key de verdade.
//   NOME = resolvido por nome normalizado (trim+upper) contra ClienteCadastro.nome — a MESMA
//          limitação que já existia antes desta migration (homônimo, variação de digitação),
//          mantida só pra não descartar histórico/linhas de /vendaspdv (loja física), que a API
//          nunca expõe com nenhum identificador de cliente, só o nome em texto livre.
enum ClienteCadastroMatchConfianca {
  ID
  NOME
}

// Registros ficam denormalizados (grupo/cor/tamanho/coleção direto na linha) porque é assim
// que o DAPIC/Power BI já exportam — evita um modelo de produto separado que a fonte não tem.
model Sale {
  id                String   @id @default(cuid())
  storeId           String
  cod               String
  produto           String
  grupo             String
  cor               String?
  tamanho           String?
  colecao           String?
  marca             String?
  clienteNome       String?
  vendedor          String?
  tabelaPreco       String?
  cidade            String?
  estado            String?
  quantidade        Int
  valorTotalLiquido Float
  valorCustoTotal   Float?
  valorFrete        Float?
  saleDate          DateTime
  // Id da venda no DAPIC (vendaspdv) + índice do item dentro dela — chave de idempotência pra
  // sync não duplicar quando a janela de datas de duas rodadas se sobrepõe (o cron roda 2x/dia
  // sempre olhando "últimos N dias", então sem isso toda venda recente era reinserida a cada sync).
  dapicVendaId      Int
  itemIndex         Int
  // Código HUMANO da venda (campo "Codigo" de /vendaspdv e /faturas) — diferente de
  // dapicVendaId (Id interno usado só pra idempotência). Pedido do Rodrigo em 2026-09-21: pro
  // template de Follow-up pós-compra mostrar o código real da venda. Nullable: vendas
  // sincronizadas antes desse campo existir ficam null pra sempre (histórico não é
  // reprocessado à toa).
  codigo            String?
  // Reconciliação de cancelamento (2026-10-01): o DAPIC permite cancelar uma venda DEPOIS de
  // fechada — quando isso acontece, o campo DataFechamento volta a null na API (não dá pra usar
  // "ainda tem DataFechamento" como sinal), então o sync original (que só olha vendas "Fechada"
  // dentro da janela normal) nunca vê a mudança. status espelha o `Status` da API no momento da
  // última sync que tocou essa linha ("Fechada" por padrão pra todo histórico anterior a esse
  // campo existir — nunca foi preciso reprocessar pra saber, API confirma o estado real).
  // canceladaEm fica null até a reconciliação achar um cancelamento de verdade. Nunca deletar a
  // linha (preserva histórico/auditoria) — ver saleWhere() em metrics/core.ts pra a regra central
  // de "venda válida" (status != "Cancelada"), não reimplementar esse filtro em cada metrica.
  status            String    @default("Fechada")
  canceladaEm       DateTime?

  // Vínculo real com ClienteCadastro — substitui o casamento só-por-nome na hora de identificar
  // "é o mesmo cliente" (ver ClienteCadastroMatchConfianca acima pro porquê de ID vs NOME, e
  // cac.ts/montarMotivoLimitacao pra limitação que isso resolve). Nullable e HONESTO: nem toda
  // venda resolve (sem clienteNome, ou nome sem nenhum ClienteCadastro correspondente) — nunca
  // inventamos um vínculo só pra preencher a coluna. Resolvido no sync pra venda NOVA (syncFaturas
  // via IdCliente = ID; syncVendas via nome = NOME) e via scripts/clientes/backfill-clientecadastro-link.ts
  // pra histórico anterior a esta migration (só NOME disponível, API não guarda IdCliente
  // retroativamente sem reconsultar o DAPIC por venda, fora do escopo deste backfill).
  clienteCadastroId           String?
  clienteCadastroMatchConfianca ClienteCadastroMatchConfianca?

  store           Store            @relation(fields: [storeId], references: [id])
  clienteCadastro ClienteCadastro? @relation(fields: [clienteCadastroId], references: [id])

  @@unique([storeId, dapicVendaId, itemIndex])
  @@index([storeId, saleDate])
  @@index([grupo])
  @@index([marca])
  @@index([status])
  @@index([clienteCadastroId])
  // saleDate isolado: saleWhere() sempre filtra por data, mas quando storeIds é undefined
  // (sell-through "empresa toda" em getStockVsSales/resolveSellThrough) o índice composto
  // [storeId, saleDate] acima não ajuda — vira scan sem índice. tabelaPreco e colecao: filtrados
  // em saleWhere() quase em toda chamada (tabelaPreco via getTabelaPrecoRestrictionSemAtacado,
  // praticamente universal; colecao quando o filtro de Coleção está em uso) e não tinham índice
  // nenhum. Achado na auditoria de performance de 2026-10-05. Não compostos com saleDate de
  // propósito — cada um cobre o próprio filtro isolado, sem apostar numa combinação específica.
  @@index([saleDate])
  @@index([tabelaPreco])
  @@index([colecao])
}

model StockSnapshot {
  id                   String   @id @default(cuid())
  storeId              String
  cod                  String
  produto              String
  grupo                String
  cor                  String?
  tamanho              String?
  colecao              String?
  quantidadeDisponivel Int
  estoqueMinimo        Int?
  valorCusto           Float?
  syncedAt             DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  // 1 linha por produto+loja, atualizada a cada sync (upsert) em vez de acumular uma linha nova
  // por rodada — sem isso a tabela crescia pra sempre (2 syncs/dia, sem limpeza), ficando lenta
  // e fazendo os totais de estoque somarem histórico em vez do valor atual.
  @@unique([storeId, cod])
  @@index([grupo])
}

// Avaliado (missão Sale<->ClienteCadastro, 2026-11-06) se Return merece o mesmo clienteCadastroId
// de Sale, pra simetria. Decisão: NÃO agora, fica como follow-up. Return nem tem clienteNome hoje
// (nunca teve) — dar a ela um vínculo de cliente direto seria inventar uma dimensão nova, não
// "aplicar o mesmo padrão" a algo que já existe. Return já carrega (storeId, dapicVendaId) — a
// MESMA chave de idempotência da Sale que originou a devolução — então quem for construir o
// "líquido de devolução" do CAC/novo-vs-recorrente (a tarefa futura que isto desbloqueia) consegue
// chegar no clienteCadastroId da venda original via JOIN por (storeId, dapicVendaId) em vez de
// duplicar a coluna aqui. Revisitar só se essa futura tarefa achar que o JOIN não é suficiente.
model Return {
  id           String   @id @default(cuid())
  storeId      String
  cod          String
  produto      String
  grupo        String
  cor          String?
  tamanho      String?
  marca        String?
  tabelaPreco  String?
  // A API (/vendaspdv) sempre manda Colecao pra linha de devolução, mas até 2026-10-01 o sync
  // gravava com createMany+skipDuplicates (imutável desde a 1ª sincronização) — se a API
  // devolvesse null na 1ª vez que o sync visse aquela devolução, ficava null pra sempre mesmo
  // depois da API corrigir (confirmado reconsultando a API: 98.9% dos registros, inclusive
  // recentes, tinham o dado certo na origem). Corrigido pra upsert que atualiza colecao no
  // conflito (ver upsertReturnsComColecaoAtualizavel em sync-runner.ts) — dado futuro se
  // autocorrige no sync seguinte; histórico precisa do backfill em
  // scripts/backfill-return-colecao.ts (reescrito nessa mesma correção, a versão antiga tinha
  // bug de matching e nunca funcionou de verdade).
  colecao      String?
  quantidade   Int
  valorTotal   Float
  returnDate   DateTime
  // Mesma lógica de idempotência do Sale — ver comentário lá. Nulo só nos registros fictícios
  // antigos (seed-fictional-returns-production.ts), que não vêm da API.
  dapicVendaId Int?
  itemIndex    Int?
  // Mesma reconciliação de cancelamento do Sale (ver comentário lá) — a devolução pertence à
  // mesma venda/fatura que pode ser cancelada depois, então precisa do mesmo campo.
  status       String    @default("Fechada")
  canceladaEm  DateTime?

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, dapicVendaId, itemIndex])
  @@index([storeId, returnDate])
  @@index([marca])
  @@index([tabelaPreco])
  @@index([status])
}

// Item "Tipo=Brinde" (vendaspdv/faturas) — antes era descartado no sync. Pedido do Rodrigo em
// 2026-08-11: mesma estrutura da Sale (pra caber no mesmo padrão de filtro/dimensão da aba
// Vendas), sem os campos específicos de venda que não fazem sentido pra brinde (tabelaPreco,
// cliente, vendedor).
model Gift {
  id                String   @id @default(cuid())
  storeId           String
  cod               String
  produto           String
  grupo             String
  cor               String?
  tamanho           String?
  colecao           String?
  marca             String?
  clienteNome       String?
  quantidade        Int
  valorTotalLiquido Float
  giftDate          DateTime
  // Mesma lógica de idempotência de Sale/Return — ver comentário lá.
  dapicVendaId      Int
  itemIndex         Int

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, dapicVendaId, itemIndex])
  @@index([storeId, giftDate])
  @@index([grupo])
}

// Reescrito em 2026-08-10 pros campos reais de /ordensproducao/produtos (endpoint só descoberto
// nessa data — a versão anterior era especulativa, nunca tinha sido testada com dado real).
// "cod" (IdGradeProduto) é o mesmo identificador usado em Sale/StockSnapshot — dataFinalizacaoProducao
// é o sinal de "quando essa peça foi produzida", usado no Envelhecimento como alternativa/complemento
// à 1ª venda (bestsellers são repostos direto, "1ª venda histórica" não reflete um lote novo).
model ProductionOrder {
  id                      String    @id @default(cuid())
  idOrdemProducao         Int
  cod                     String
  ordemProducao           String
  referencia              String
  produto                 String
  cor                     String?
  tamanho                 String?
  grupo                   String
  marca                   String?
  colecao                 String?
  quantidade              Int
  quantidadeOriginal      Int
  status                  String
  dataFinalizacaoProducao DateTime?
  dataEntradaCelula       DateTime?

  @@unique([idOrdemProducao, cod])
  @@index([cod])
  @@index([grupo])
}

// Parcelas em aberto do DAPIC (/contas/parcelas, Status=Aberta). Tabela é truncada e
// reinserida a cada sync — snapshot do momento atual de inadimplência, não histórico.
model Parcela {
  id                String   @id @default(cuid())
  idParcela         Int      @unique
  idConta           Int
  status            String
  dataEmissao       DateTime
  dataVencimento    DateTime
  conta             String
  formaPagamento    String
  pessoa            String
  numeroParcela     Int
  valor             Float
  valorPago         Float
  valorAberto       Float
  valorMulta        Float
  valorJuros        Float
  nossoNumeroBoleto String?
  planoConta        String? // "4.1.4" = atacado B2B, "4.1.3" = site varejo

  @@index([dataVencimento])
  @@index([formaPagamento])
  @@index([planoConta])
}

// Cache do catálogo de /tabelaprecos (preço por SKU por tabela), 1 linha por token/loja. Preço
// não muda de hora em hora, mas antes buscávamos de novo em TODO sync (2x/dia + botão manual) —
// achado em 2026-08-12 que isso contribuía pra sync ficar perto do teto de 300s da Vercel
// (contenção de API rodando 4 lojas em paralelo). Refresh só quando mais velho que
// PRICE_CATALOG_MAX_AGE_HORAS (ver tabela-preco.ts).
model PriceCatalogCache {
  id          String   @id @default(cuid())
  clientLabel String   @unique
  data        Json
  updatedAt   DateTime @updatedAt
}

// Cache do access_token do login do DAPIC (válido 24h), persistido entre invocações — cada
// sync roda como uma função serverless nova (Vercel), então o cache em memória do DapicClient
// não sobrevive de uma chamada pra outra. Sem isso, toda sincronização (5x/dia: 3 principais +
// 2 de segurança, fora Force Sync manual e o auto-heal) fazia login de novo pros ~5 tokens,
// batendo perto do rate limit do DAPIC (5 requisições/60s) toda vez. Com o cache, login de
// verdade só acontece 1x a cada ~24h por token.
model DapicTokenCache {
  label       String   @id
  accessToken String
  expiresAt   DateTime
}

model ClienteCadastro {
  id             String    @id @default(cuid())
  dapicId        Int       @unique
  nome           String
  telefone       String?
  celular        String?
  email          String?
  dataNascimento DateTime?
  // CPF (pessoa física) ou CNPJ (pessoa jurídica) — mesmo campo bruto do DAPIC (CpfCnpj),
  // já formatado com pontuação. Pedido do Rodrigo em 2026-08-28.
  cpfCnpj        String?

  // Data da 1ª compra do cliente numa base ANTERIOR ao DAPIC (ex: site antigo na vnda,
  // 2021-2025) — só a data, sem dado de produto/receita. Usado exclusivamente pra corrigir a
  // classificação de "cliente novo" (getPrimeiraCompraGlobalPorCliente em metrics.ts), que sem
  // isso marcava como "novo" quem só tinha voltado a comprar depois de anos como cliente antigo
  // (achado pelo Rodrigo em 2026-08-31, cruzando por CPF: 226 clientes real do vnda desde
  // 2021-2023 apareciam como "novo" no dashboard). Preenchido 1x via
  // scripts/backfill-primeira-compra-externa.ts, nunca pelo sync do DAPIC.
  primeiraCompraExterna DateTime?
  fonteExterna          String?

  // Funcionário/vendedor "dono" do cliente no cadastro do DAPIC (campo Funcionario em /clientes)
  // — diferente do vendedor gravado em cada Sale (quem bateu aquela venda específica). Pedido do
  // Rodrigo em 2026-09-01: quando a loja corrige o vendedor responsável de um cliente DEPOIS de
  // uma venda já ter sido sincronizada com outro vendedor (ex: quem atendeu de fato o cliente foi
  // outra pessoa), a Sale antiga não é reescrita — comparar contra esse campo (sempre atualizado a
  // cada sync) é como a divergência é detectada em getVendedorDivergente().
  vendedorResponsavel String?

  sales Sale[]

  @@index([nome])
}

// Pedidos do site antigo (plataforma vnda, 2021-2025), 1 linha por pedido (Tipo="Total" no
// export original — já é o valor final do pedido, sem precisar somar frete/produto/desconto
// separado). Pedido do Rodrigo em 2026-08-31: depois de só importar a data de 1ª compra achar
// "invisível" demais, ele quis que aparecesse de verdade em Retenção/Segmentação/receita da
// Visão Geral de Clientes — MAS sem entrar em nenhum gráfico por Grupo/Produto/Tamanho (o vnda
// usa nomenclatura de produto genérica demais pra combinar com o DAPIC, ex: "Classic" vs
// "Classic Lisa"/"Classic Blend"/"Classic Dry" reais). Por isso não tem grupo/produto/tamanho
// aqui — só o necessário pro lado CRM: quem comprou, quando, quanto. Tabela separada da Sale de
// propósito, pra zero risco de vazar pra Vendas/Estoque×Vendas sem querer. Preenchida 1x via
// scripts/backfill-vendas-historicas-externas.ts, nunca pelo sync do DAPIC.
model VendaHistoricaExterna {
  id            String   @id @default(cuid())
  clienteNome   String
  cpfCnpj       String?
  // Cidade/estado do pedido (endereço de entrega no vnda) — pedido do Rodrigo em 2026-08-31,
  // "de onde é o cliente" na Ficha. Não é endereço fixo do cliente, é só o que veio naquele
  // pedido específico (mesma limitação que Sale.cidade/estado já tem).
  cidade        String?
  estado        String?
  pedidoExterno String   @unique
  saleDate      DateTime
  valorTotal    Float
  fonte         String   @default("vnda")

  @@index([clienteNome])
  @@index([saleDate])
}

// Grupos de produto marcados como prioritários para vendedores (administrável, sem UI ainda).
model PriorityGroup {
  id    String @id @default(cuid())
  grupo String @unique
}

// "Já contatei esse cliente" na aba Sugestões de Contato — marcado sozinho no clique do link do
// WhatsApp (não é confirmação de entrega de verdade, isso exigiria WhatsApp Business API; é só a
// aproximação "clicou = considerou contatado"). Pedido do Rodrigo em 2026-09-09, pra dar
// visibilidade de quem da equipe já mandou mensagem pra quem, sem duplicar contato.
// "chave" distingue a pendência específica dentro do mesmo cliente: motivo (ex: "VIP esfriando")
// pras sugestões, ou dapicVendaId (como string) pro follow-up pós-compra — assim o mesmo cliente
// pode ter marcações independentes se aparecer em mais de um motivo/compra ao mesmo tempo.
model ContatoMarcado {
  id           String   @id @default(cuid())
  tipo         String
  cliente      String
  chave        String
  contatadoPor String
  // Loja do login que marcou o contato (getStoreRestriction, só quando é login de loja única —
  // ver resolverContatadoPor em actions.ts). Null = marcado por login multi-loja (admin/gestão/
  // atendimento) ou registro antigo sem essa info, e nesse caso não aparece pra quem só vê 1
  // loja (não dá pra confirmar de qual loja é). Achado pelo Rodrigo em 2026-09-22: login de loja
  // única via contato de TODAS as lojas em "Contatos por Vendedor", que nunca filtrava por loja.
  storeId      String?
  contatadoEm  DateTime @default(now())

  @@unique([tipo, cliente, chave])
}

// Cache do número de nota/cupom fiscal (ver getNumeroNotaFiscal em connectors/nota-fiscal.ts) —
// achado em 2026-09-10: buscar isso ao vivo no DAPIC pra ~100 clientes do follow-up TODA VEZ que
// alguém abre a aba Sugestões de Contato deixava a página perto de 1min de carregamento (mesmo
// limitando a concorrência). O número de uma venda passada nunca muda, então cacheia pra sempre
// depois da 1ª busca — só venda NOVA no follow-up (poucas por dia) precisa de busca ao vivo.
// "numero" nulo é cacheado também (venda sem nota encontrada), pra não ficar tentando de novo.
model NotaFiscalCache {
  id           String   @id @default(cuid())
  storeId      String
  dapicVendaId Int
  numero       String?
  resolvedAt   DateTime @default(now())
  // Campos adicionados em 2026-11-11 pra seção de Notas Fiscais da Ficha do Cliente — nullable,
  // preenchidos só a partir de agora (registros antigos de "numero" ficam com esses 3 null pra
  // sempre, não há reprocessamento automático). chaveAcesso: 44 dígitos, só disponível pra
  // Site+Atacado (fatura) ou, raramente, NFE de loja física via /notasfiscais/{id} (best-effort,
  // ver fetchNotaFiscalDetalhe em connectors/dapic.ts) — NFC-e de loja física nunca tem.
  chaveAcesso  String?
  numeroSerie  Int?
  // "FATURA" (Site+Atacado) | "NFCE" | "NFE" | "CFE" (loja física) | null (não resolvido/erro).
  tipo         String?

  @@unique([storeId, dapicVendaId])
}

// Trava simples pra evitar 2 sincronizações completas rodando ao mesmo tempo — achado em
// 2026-09-11: até então só existiam os 5 horários fixos diários (bem espaçados, nunca colidiam
// de verdade), mas com o agendador externo batendo a cada 10min (pedido do Rodrigo, pra manter o
// banco mais fresco) e uma sync completa podendo levar até ~4min e meio num dia lento do DAPIC, a
// folga ficou pequena o suficiente pra virar risco real de sobreposição. Uma linha só (id fixo
// "sync"): "rodando" = finishedAt nulo E startedAt recente; lock considerado travado (stale) e
// destravável depois de LOCK_STALE_MIN, pra nunca ficar preso pra sempre se um processo morrer no
// meio sem atualizar finishedAt.
model SyncLock {
  id         String    @id
  startedAt  DateTime
  finishedAt DateTime?
}

// Templates das mensagens de WhatsApp de Sugestões de Contato — pedido do Rodrigo em 2026-09-11
// pra editar o texto de cada segmento numa tela, sem precisar me pedir toda vez que quiser mudar
// uma palavra. "id" é uma chave fixa (ver TEMPLATE_KEYS em src/lib/message-templates.ts), "texto"
// é o corpo com placeholders tipo {nome}/{detalhe}/{produtos} (cada chave só aceita os
// placeholders que fazem sentido pra ela — ver TEMPLATE_KEYS). O gancho de estoque (produto
// favorito) e o número da nota fiscal do follow-up continuam sendo acrescentados pelo código
// depois do texto editável — são dinâmicos/condicionais demais pra virar texto livre com risco
// de o Rodrigo quebrar o placeholder sem querer.
model MensagemTemplate {
  id           String   @id
  texto        String
  atualizadoEm DateTime @updatedAt
}

enum ContentTipo {
  STORY
  POST
  REPOST
  VISITA
}

enum ContentClassificacao {
  QUALIFICADO
  BASICO
}

// Registro individual de 1 conteúdo (1 story ou 1 post), não agregado mensal — pedido explícito
// do Rodrigo em 2026-09-14 pra manter os dados flexíveis o bastante pra qualquer corte de
// análise (dia/semana/mês, por pessoa, por tipo, por classificação) sem precisar reestruturar
// depois. "classificacao" é sempre lançada manualmente (nunca inferida por engajamento) — decisão
// de processo da equipe, não uma métrica calculada. "perfil" é texto livre (mesmo padrão de
// Sale.vendedor/clienteNome — sem tabela de cadastro de pessoa separada), com autocomplete via
// getDistinctPerfis() pra evitar variação de digitação sem travar quem for novo.
model ContentPerformance {
  id            String               @id @default(cuid())
  perfil        String
  tipo          ContentTipo
  classificacao ContentClassificacao
  data          DateTime
  // Nem todo conteúdo tem engajamento disponível na hora do lançamento — opcional de propósito,
  // pra não forçar um "0" que contaminaria médias.
  engajamento   Int?
  observacoes   String?
  // Loja física onde o conteúdo foi feito (opcional — pedido do Rodrigo em 2026-09-14, pra ver
  // performance também por loja, não só por pessoa). Reaproveita o Store já existente em vez de
  // duplicar cadastro de loja. Null = conteúdo não amarrado a uma loja específica (ex: feito fora
  // do ponto de venda).
  storeId       String?
  // Nome de quem lançou o registro (auditoria simples, mesmo espírito de ContatoMarcado.contatadoPor).
  registradoPor String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  store Store? @relation(fields: [storeId], references: [id])

  @@index([perfil])
  @@index([data])
  @@index([tipo])
  @@index([storeId])
}

enum SyncSource {
  SALES
  STOCK
  RETURNS
  PRODUCTION
  GIFTS
  // Adicionados na missão Black Friday (2026-11): até aqui, Meta Ads e GA4 não tinham SyncSource
  // próprio — getSyncStatusDetalhado() só conseguia expor frescor de CACHE de dado pro Meta Ads
  // (PriceCatalogCache, só atualiza em sucesso) e nada pro GA4, sem jeito de saber se a ÚLTIMA
  // tentativa de buscar qualquer um dos dois falhou. Gravado por analytics-site/page.tsx (não
  // meta-ads.ts/google-analytics.ts, que são owned por outro agente nesta missão) a cada
  // carregamento real da aba Analytics — só nas chamadas que representam "os dados estão
  // atualizados" (getInsightsPorConjunto/getInsightsPorAnuncio, funções de GA4), nunca no fetch
  // de fotos/cache de criativo.
  META_ADS
  GA4
}

enum SyncStatus {
  SUCCESS
  FAILED
}

model SyncLog {
  id            String     @id @default(cuid())
  storeId       String?
  source        SyncSource
  status        SyncStatus
  recordsSynced Int        @default(0)
  message       String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  store Store? @relation(fields: [storeId], references: [id])
}

// Registro persistente de "já vimos esse armazém" pro alerta de "armazém novo no DAPIC"
// (sync-runner.ts, syncArmazenadores) — achado em 2026-10-31: o alerta comparava por NOME
// (Store.code) contra o estado do banco no início de cada sync, não por ID estável; o próprio
// Store.code também nunca era atualizado quando o nome mudava, então qualquer divergência de
// nome ficava permanente e reacendia o alerta "novo" em toda sincronização seguinte. A chave
// aqui é (clientLabel, dapicArmazenadorId) — o ID do DAPIC é estável, o nome é só informativo
// (nomeAtual), atualizado sem gerar novo alerta nem nova linha. clientLabel entra na chave porque
// cada token DAPIC (cd-atacado, leblon, barra, rio-sul, matriz) tem sua PRÓPRIA numeração de
// armazenador — o mesmo Id em tokens diferentes não é o mesmo armazém.
model ArmazemConhecido {
  id                 String   @id @default(cuid())
  clientLabel        String
  dapicArmazenadorId Int
  nomeAtual          String
  // "VENDE" | "NAO_VENDE" — snapshot da regra sellsProducts() no momento do último sync que viu
  // esse armazém. Texto livre (não enum) de propósito: é só informativo/auditoria, não chave de
  // nenhuma lógica — evita precisar de migration nova se a classificação ganhar um 3º estado.
  classificacao      String
  primeiraVezVistoEm DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  @@unique([clientLabel, dapicArmazenadorId])
}


// Rebuild do núcleo de qualificação B2B (Fase 1, 2026-11) — pedido do Rodrigo de trocar
// "qualquer loja com CNAE de vestuário" por "revendedor multimarcas de moda masculina verificado,
// com potencial comercial real pra TVB" (qualidade, não quantidade: 300 prospects excelentes >
// 5000 CNPJs inúteis). Ver src/lib/prospeccao/motor-qualificacao.ts pra lógica completa — os
// campos abaixo só guardam o RESULTADO do motor, nunca recalculado aqui no schema.
enum ClassificacaoProspectComercial {
  ALTA_PRIORIDADE
  QUALIFICADO
  REPROVADO
}

// Status de workflow, DIFERENTE da classificação de qualidade acima: o motor de qualificação
// NUNCA grava APROVADO sozinho (ver motor-qualificacao.ts) — isso é sempre uma promoção manual
// feita por uma pessoa depois de revisar um PENDENTE_REVISAO_HUMANA. Só APROVADO entra na base
// comercial definitiva; PENDENTE_REVISAO_HUMANA fica numa fila separada, nunca auto-promovido.
enum StatusComercialProspect {
  APROVADO
  EM_INVESTIGACAO
  REPROVADO
  PENDENTE_REVISAO_HUMANA
}

enum ResultadoGateEliminacao {
  APROVADO_GATE
  REPROVADO
  INCONCLUSIVO
}

// Matriz x filial pelo mesmo cnpjRaiz (8 primeiros dígitos do CNPJ) — filiais NÃO são
// descartadas automaticamente (podem ser oportunidades comerciais independentes), mas devem
// respeitar a cota geográfica por município como qualquer outro prospect (ver quota-geografica.ts),
// nunca contar em dobro só porque são "a mesma empresa".
enum TipoEstabelecimentoProspect {
  MATRIZ
  FILIAL
}

enum TipoEvidenciaMarca {
  SITE_OFICIAL
  CATALOGO_PRODUTO
  INSTAGRAM_COMERCIAL
  POST_PRODUTO
  FOTO_VITRINE
  MARKETPLACE
  OUTRA_FONTE_VERIFICAVEL
}

enum NivelConfiancaProspect {
  ALTA
  MEDIA
  BAIXA
}

// Prospectos comerciais B2B ainda não convertidos em clientes do DAPIC.
// Mantido separado de ClienteCadastro, que representa exclusivamente clientes sincronizados.
model AtacadoProspect {
  id               String   @id @default(cuid())
  razaoSocial      String?
  nomeFantasia     String
  cnpj             String?  @unique
  cidade           String?
  codigoMunicipio  String?
  estado           String?
  site             String?
  instagram        String?
  grupoComercial   String   @default("PENDENTE")
  scoreComercial   Int?
  justificativaGrupo String?
  confiancaPesquisa String?
  nomeComercialVerificado Boolean @default(false)
  pesquisadoEm     DateTime?
  // Resultado estruturado da consulta oficial Receita Federal/Serpro.
  situacaoCadastral       String?
  situacaoCadastralCodigo String?
  situacaoCadastralData   DateTime?
  cnaePrincipalCodigo     String?
  cnaePrincipalDescricao  String?
  cnaesSecundarios        String?
  enderecoOficial         String?
  cepOficial              String?
  porteEmpresa            String?
  dataAbertura            DateTime?
  // Atributos comerciais observáveis usados para aprender quais perfis avançam no funil.
  segmentoComercial String?
  perfilLoja        String?
  faixaPreco        String?
  origemAgente      String?
  telefone         String?
  email            String?
  origem           String   @default("manual")
  evidenciaUrl     String?
  evidenciaEm      DateTime?
  status           String   @default("NOVO")
  responsavel      String?
  observacoes      String?
  criadoPor        String?
  convertidoEm     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // --- Núcleo do motor de qualificação (rebuild Fase 1, 2026-11) ---
  // Resultado estruturado do gate de elegibilidade e da pontuação (ver motor-qualificacao.ts).
  // scoreComercial acima continua sendo o total 0-100 (reaproveitado); scoreDetalhe guarda o
  // detalhamento por sub-critério + rationale (nunca só o número final, pra ficar auditável).
  classificacaoProspect  ClassificacaoProspectComercial?
  statusComercial        StatusComercialProspect @default(EM_INVESTIGACAO)
  resultadoEliminacao    ResultadoGateEliminacao?
  motivosEliminacao      String[] @default([])
  scoreDetalhe           Json?
  // Evidências estruturadas por critério (existência, atividade, varejo, moda masculina,
  // posicionamento TVB, sinais de potencial comercial) — ver tipo Evidencia em
  // motor-elegibilidade.ts. Marcas de terceiros NÃO ficam aqui: têm tabela própria
  // (AtacadoProspectBrand) porque são o requisito central e precisam ser auditáveis 1 a 1.
  evidenciasQualificacao Json?
  tipoEstabelecimento    TipoEstabelecimentoProspect?
  // 8 primeiros dígitos do CNPJ — agrupa matriz/filiais da mesma empresa sem duplicar cadastro;
  // ver enum TipoEstabelecimentoProspect acima.
  cnpjRaiz               String?
  capitalEstadual        Boolean @default(false)
  // Campos normalizados (trim/lowercase/sem acento) só pra VARREDURA de possível duplicata —
  // nunca uma constraint UNIQUE: filiais de uma mesma rede legitimamente repetem nome fantasia
  // em municípios diferentes, e endereço sozinho não é identidade de empresa. Dedup de verdade
  // (bloqueante) continua sendo só o cnpj @unique abaixo; isto aqui alimenta
  // detectarPossivelDuplicata() pra fila de revisão humana, nunca bloqueia um insert.
  nomeFantasiaNormalizado String?
  enderecoNormalizado     String?
  // Data da última validação/reconfirmação de evidência (distinto de pesquisadoEm, que é a
  // pesquisa mais recente feita — ultimaValidacaoEm é especificamente "confirmamos que isso
  // ainda é verdade", usado por uma futura auditoria adversarial pra achar informação velha).
  ultimaValidacaoEm       DateTime?
  // --- Ponto de extensão pra auditoria adversarial (fase futura, NÃO implementada aqui) ---
  // Um agente independente pode reabrir qualquer prospect (mesmo já APROVADO) pra caçar marca
  // inventada, loja inativa, informação desatualizada, fabricante sem revenda disfarçado etc.
  // Texto livre de propósito (não enum): o processo adversarial ainda não existe, então o
  // conjunto de resultados possíveis pode mudar sem precisar de migration nova.
  revisaoAdversarialStatus String?
  revisaoAdversarialEm     DateTime?
  revisaoAdversarialPor    String?

  activities AtacadoProspectActivity[]
  brands     AtacadoProspectBrand[]

  @@index([estado, cidade])
  @@index([status, updatedAt])
  @@index([nomeFantasia])
  @@index([cnpjRaiz])
  @@index([statusComercial])
  @@index([classificacaoProspect])
  @@index([nomeFantasiaNormalizado])
}

model AtacadoProspectActivity {
  id          String   @id @default(cuid())
  prospectId  String
  tipo        String
  descricao   String
  // Resultado estruturado da interação: INTERESSADO, SEM_RESPOSTA, RECUSOU, PEDIU_CATALOGO etc.
  resultado   String?
  canal       String?
  etapa       String?
  criadoPor   String?
  createdAt   DateTime @default(now())

  prospect AtacadoProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

// Evidência de UMA marca de terceiro revendida por um prospect — requisito central do rebuild
// (ver motor-elegibilidade.ts avaliarMultimarcas): autodescrição "somos multimarcas" nunca basta,
// precisa de marca + evidência específica + fonte + data + tipo + confiança, registrados 1 a 1.
// marcaNormalizada é a chave de dedupe (trim/lowercase/sem acento) — duas linhas do mesmo produto
// da MESMA marca nunca devem virar duas marcas distintas; @@unique garante isso no banco também,
// não só na validação em memória do motor.
model AtacadoProspectBrand {
  id               String                 @id @default(cuid())
  prospectId       String
  marca            String
  marcaNormalizada String
  evidencia        String
  fonteUrl         String
  dataVerificacao  DateTime
  tipoEvidencia    TipoEvidenciaMarca
  confianca        NivelConfiancaProspect
  createdAt        DateTime               @default(now())

  prospect AtacadoProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([prospectId, marcaNormalizada])
  @@index([prospectId])
}

// Override manual (temporário) do banner promocional de Black Friday — mesma convenção de
// MapaComprasConfig/PromotionRulesConfig (linha única, id fixo "global"). As datas da janela
// automática (2026-11-10 06:00 a 2026-12-01 06:00, horário de Brasília) são fixas no código
// (black-friday-banner.ts), não ficam aqui: pedido do Rodrigo em 2026-11-05 foi explícito que
// isso não é campo editável pelo admin. `modoManual` só serve pra FORÇAR o banner visível antes
// da janela abrir ou escondido durante ela — null = respeita a janela automática. Sem linha
// ainda = também respeita a automática (mesmo default de "nunca configurado" que os outros
// singletons).
model BlackFridayBannerConfig {
  id              String   @id
  modoManual      String?
  updatedAt       DateTime @updatedAt
  updatedByEmail  String?
}

// Tabela de preço/desconto REAL da Black Friday (planilha "Preços Black Friday.xlsx" do Rodrigo,
// 218 produtos, pedido em 2026-11-06) — cadastral, preenchida por importação (ver
// scripts/black-friday/importar-precos.ts), nunca editada pela UI. Grain é grupo+produto, o mesmo
// grain já usado em getSalesByGrupoProduto/getTopProdutosBlackFriday (ver black-friday.ts) — NÃO
// existe tabela master de Produto neste projeto (mesmo motivo de ClassificacaoProduto acima), por
// isso o cadastro aqui também é keyado por grupo+produto, não por um id de produto.
//
// `colecao` é só descritiva (vem da planilha, não usada pra chave nem pra bucket de desconto —
// quem decide a faixa de desconto é `desconto`, direto). `precoCheio`/`precoComDesconto` são
// nullable: a planilha real tem linha(s) com "Preço" vazio (2 casos confirmados, grupo "Code") —
// importar como null em vez de inventar 0 ou descartar a linha (mesma convenção de "exibição
// honesta de dado faltante" já usada pra classificação Best Seller/Drop nesta tela).
model PrecoBlackFriday {
  id               String   @id @default(cuid())
  grupo            String
  produto          String
  colecao          String?
  precoCheio       Float?
  desconto         Float
  precoComDesconto Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([grupo, produto])
  @@index([desconto])
}

// Meta diária de faturamento da Black Friday (planilha "Plano BF 2026.xlsx" do Rodrigo, importada
// por scripts/black-friday/importar-meta-diaria.ts) — alimenta o painel "Meta vs. Real" da Central
// Black Friday (ver getComparativoMetaDiariaBlackFriday em src/lib/metrics/black-friday.ts).
// Escopo deliberadamente restrito ao PERÍODO DA CAMPANHA (pedido explícito do Rodrigo, 2026-11-06:
// "só o periodo da black") — não é um sistema de meta anual, uma linha por dia só existe pra cada
// dia que a planilha de fato cobre.
//
// `data` é meia-noite de Brasília daquele dia (mesma convenção de brasiliaDayStart em
// lib/filters.ts), pra bater exatamente com o "day" (YYYY-MM-DD) que getSalesByDay devolve na
// hora de cruzar meta/real por dia.
//
// `receitaReal2025` é nullable: a planilha real (confirmada em 2026-11-06) tem valor em todas as
// 30 linhas hoje, mas o campo fica honesto pro caso de uma atualização futura vir com dia faltando
// — nunca mostra 0%/crescimento fabricado pra um dia sem dado 2025 (ver comentário da função que
// consome isso).
//
// `canais` é um blob JSON cru das colunas de canal da planilha (Segmentação, E-mail Mkt/Whatsapp/
// SMS, Instagram/TikTok, Mídia Paga, Lojas, mais Ação 2025/%participação do bloco comparativo) —
// essas colunas são só informativas/exibição, não entram em nenhum cálculo, então não compensa
// normalizar em colunas próprias (mesma lógica de "Json quando é só pra mostrar" já usada em
// outros lugares do schema).
model MetaDiariaBlackFriday {
  id               String   @id @default(cuid())
  data             DateTime @unique
  metaReceita2026  Float
  receitaReal2025  Float?
  acao             String?
  canais           Json?
  updatedAt        DateTime @updatedAt
}
