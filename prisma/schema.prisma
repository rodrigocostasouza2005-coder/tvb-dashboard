generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GESTAO
  VENDEDOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VENDEDOR)
  // Lista de chaves de aba liberadas pra esse usuário (ver src/lib/tabs.ts).
  // Vazio = usa o padrão do role (comportamento de antes, continua funcionando sozinho).
  allowedTabs  String[] @default([])
  createdAt    DateTime @default(now())

  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Uma loja/unidade (o "Armazenador" no DAPIC). Matriz não vende (sellsProducts=false).
// dapicArmazenadorId liga direto com o Id retornado por GET /armazenadores na API real —
// nem todo armazenador é uma loja de verdade (ex: "Defeito", "Lixeira", "Bonificação").
model Store {
  id                 String  @id @default(cuid())
  code               String  @unique
  name               String
  sellsProducts      Boolean @default(true)
  dapicArmazenadorId Int?    @unique
  // Quando preenchido, agrupa essa loja com outras de mesmo displayGroup em uma única opção
  // no filtro (ex: CD e ATACADO viram um checkbox só "TVB Site e Atacado"), sem perder os
  // dados separados por baixo — evita somar/sobrescrever quantidade errado.
  displayGroup       String?

  sales               Sale[]
  stockSnapshots      StockSnapshot[]
  returns             Return[]
  syncLogs            SyncLog[]
  stockMinimumRules   StockMinimumRule[]
}

// Estoque mínimo definido manualmente pelo Rodrigo (o valor que vem do DAPIC nem sempre é
// bom) — colecao nulo = vale pra qualquer coleção desse grupo+tamanho+loja. Regra mais
// específica (com colecao) ganha da mais genérica na hora de aplicar.
model StockMinimumRule {
  id          String   @id @default(cuid())
  storeId     String
  grupo       String
  tamanho     String
  colecao     String?
  valorMinimo Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, grupo, tamanho, colecao])
}

// Registros ficam denormalizados (grupo/cor/tamanho/coleção direto na linha) porque é assim
// que o DAPIC/Power BI já exportam — evita um modelo de produto separado que a fonte não tem.
model Sale {
  id                String   @id @default(cuid())
  storeId           String
  cod               String
  produto           String
  grupo             String
  cor               String?
  tamanho            String?
  colecao           String?
  marca             String?
  clienteNome       String?
  vendedor          String?
  tabelaPreco       String?
  cidade            String?
  estado            String?
  quantidade        Int
  valorTotalLiquido Float
  valorCustoTotal   Float?
  valorFrete        Float?
  saleDate          DateTime

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, saleDate])
  @@index([grupo])
  @@index([marca])
}

model StockSnapshot {
  id                    String   @id @default(cuid())
  storeId               String
  cod                   String
  produto               String
  grupo                 String
  cor                   String?
  tamanho               String?
  colecao               String?
  quantidadeDisponivel  Int
  estoqueMinimo         Int?
  valorCusto            Float?
  syncedAt              DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, cod, syncedAt])
  @@index([grupo])
}

model Return {
  id         String   @id @default(cuid())
  storeId    String
  cod        String
  produto    String
  grupo      String
  cor        String?
  tamanho    String?
  quantidade Int
  valorTotal Float
  returnDate DateTime

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, returnDate])
}

model ProductionOrder {
  id                   String   @id @default(cuid())
  grupo                String
  referencia           String?
  produto              String
  tamanho              String?
  quantidadeFinalizada Int
  dataPrevisao         DateTime?
  ordemProducao        String
  cod                  String?

  @@index([grupo])
}

// Grupos de produto marcados como prioritários para vendedores (administrável, sem UI ainda).
model PriorityGroup {
  id    String @id @default(cuid())
  grupo String @unique
}

enum SyncSource {
  SALES
  STOCK
  RETURNS
  PRODUCTION
}

enum SyncStatus {
  SUCCESS
  FAILED
}

model SyncLog {
  id            String     @id @default(cuid())
  storeId       String?
  source        SyncSource
  status        SyncStatus
  recordsSynced Int        @default(0)
  message       String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  store Store? @relation(fields: [storeId], references: [id])
}
